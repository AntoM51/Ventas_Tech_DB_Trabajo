/* CONSULTA 01: Resumen ejecutivo mensual */

SELECT 
	MONTH(fecha_venta) AS Mes,
	COUNT(id_venta) AS Cantidad_Pedidos,
	SUM(cantidad * precio_unitario) AS Total_Facturado,
	AVG(cantidad * precio_unitario) AS Ticket_Promedio
FROM dbo.ventas
GROUP BY MONTH(fecha_venta)
ORDER BY Mes;

-- Dato: Mes 3 con 10 pedidos, se facturó 6444 con un ticket promedio de 644.40.
-- Análisis: Muestra un volumen bueno de transacciones con un ticket promedio solido.

/* CONSULTA 02: Ranking de productos */

SELECT TOP 5
	id_producto,
	SUM(cantidad) AS Unidades_Vendidas,
	SUM(cantidad * precio_unitario) AS Total_Generado
FROM dbo.ventas
GROUP BY id_producto
ORDER BY Total_Generado DESC;

-- Dato: El id_producto 1 es el mayor por 3600 (3 unidades vendidas), mientras que el id_producto 2 es el menor por 364 (13 unidades vendidas).
-- Análisis: Si bien el producto 1 tiene un alto valor unitario y el producto 2 tiene un bajo valor unitario, el segundo producto se vende en mayor cantidad. Esto demuestra que hay productos 'premium' y productos de alta rotación.

/* CONSULTA 03: Clientes recurrentes */

SELECT 
    id_cliente,
    COUNT(id_venta) AS Cantidad_Pedidos,
    SUM(cantidad * precio_unitario) AS Total_Gastado
FROM ventas
GROUP BY id_cliente
HAVING COUNT(id_venta) > 1;

-- Dato: 2 pedidos por cada cliente, con diferencias en el gasto total (id_cliente 1 gastó 2640 y id_cliente 4 gastó 510).
-- Análisis: Si bien todos los clientes recurrentes cumplieron la condición de más de un pedido, el id_cliente 1 representa un cliente de 'alto valor', gastando más de 5 veces lo que gasta otro cliente recurrente, como el 4, a pesar de tener la misma cantidad de pedidos.

/* CONSULTA 04: Meses por encima / por debajo del promedio */

WITH VentasMensuales AS (
    SELECT 
        MONTH(fecha_venta) AS Mes,
        SUM(cantidad * precio_unitario) AS Total_Mes
    FROM ventas
    GROUP BY MONTH(fecha_venta)
),
PromedioGeneral AS (
    SELECT AVG(Total_Mes) AS Promedio_Mensual
    FROM VentasMensuales
)
SELECT 
    VM.Mes,
    VM.Total_Mes,
    CASE 
        WHEN VM.Total_Mes >= PG.Promedio_Mensual THEN 'Por encima'
        ELSE 'Por debajo'
    END AS Etiqueta_Rendimiento
FROM VentasMensuales VM
CROSS JOIN PromedioGeneral PG;

-- Dato: El mes 3 alcanza los 6444 y queta etiquetado como 'Por encima'.
-- Análisis: Confirma que el mes 3 supera la media histórica del negocio, comportándose como un periodo de alta tracción comercial.
